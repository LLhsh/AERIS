QMainWindow {
    background-color: #FAFAFA; /* 浅灰白色背景 */
}

QWidget#leftPanel {
    background-color: #F0F0F0; /* 浅灰色侧边栏 */
    border-radius: 8px;
}

QLabel {
    color: #333333; /* 深灰色文字 */
    font-size: 10pt;
    padding-bottom: 2px;
}

QLabel#fileLabel, QLabel#statusLabel {
    font-size: 9pt;
    color: #666666; /* 中灰色文字 */
    padding-top: 2px;
    padding-bottom: 5px;
}

QLabel#loadingLabel { /* 加载动画文字样式 */
    font-size: 10pt;
    color: #1976D2; /* 蓝色文字 */
    padding-top: 5px;
}

QPushButton {
    background-color: #2196F3; /* 蓝色按钮 */
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 5px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1976D2; /* 深蓝色悬停效果 */
}

QPushButton:pressed {
    background-color: #0D47A1; /* 更深蓝色按下效果 */
}

QPushButton:disabled {
    background-color: #BDBDBD; /* 灰色禁用效果 */
    color: #757575;
}

QTextEdit {
    background-color: white;
    color: #333333;
    border: 1px solid #DDDDDD;
    border-radius: 5px;
    padding: 8px;
    font-size: 10pt;
}

QTextEdit#userPromptTextEdit[isPlaceholder="true"] {
    color: #9E9E9E; /* 灰色提示文字 */
    font-style: italic;
}

QTextEdit#userPromptTextEdit[isPlaceholder="false"] {
    color: #333333; /* 深灰色正常文字 */
    font-style: normal;
}

QTableWidget {
    background-color: white;
    color: #333333;
    border: 1px solid #DDDDDD;
    gridline-color: #EEEEEE; /* 浅灰色网格线 */
    alternate-background-color: #F5F5F5; /* 浅灰色交替行 */
    font-size: 9pt;
}

QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid #EEEEEE;
    border-right: 1px solid #EEEEEE;
}

QTableWidget::item:focus {
    outline: none;
    background-color: transparent;
}

QTableWidget::item:selected {
    background-color: #E3F2FD; /* 浅蓝色选中效果 */
    color: #333333;
}

QHeaderView::section {
    background-color: #E0E0E0; /* 浅灰色表头 */
    color: #333333;
    padding: 6px;
    border: 1px solid #DDDDDD;
    font-size: 10pt;
    font-weight: bold;
}

QSplitter::handle {
    background-color: #EEEEEE;
}

QSplitter::handle:horizontal {
    width: 1px;
    margin: 2px 0;
}

QSplitter::handle:vertical {
    height: 1px;
    margin: 0 2px;
}

QSplitter::handle:pressed {
    background-color: #2196F3;
}

QScrollBar:vertical {
    border: none;
    background: #F5F5F5;
    width: 12px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #BDBDBD; /* 灰色滚动条手柄 */
    min-height: 25px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #9E9E9E; /* 深灰色悬停效果 */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #F5F5F5;
    height: 12px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    background: #BDBDBD;
    min-width: 25px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #9E9E9E;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QMessageBox {
    background-color: white;
}

QMessageBox QLabel {
    color: #333333;
    font-size: 10pt;
    padding: 10px;
}

QMessageBox QPushButton {
    background-color: #2196F3;
    color: white;
    border: none;
    padding: 8px 15px;
    border-radius: 4px;
    min-width: 80px; 
    margin: 5px;
}

QMessageBox QPushButton:hover {
    background-color: #1976D2;
}

QComboBox {
    background-color: white;
    border: 1px solid #DDDDDD;
    border-radius: 4px;
    padding: 5px 10px;
    min-height: 25px;
    color: #333333;
}

QComboBox:hover {
    border: 1px solid #BBBBBB;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #DDDDDD;
    border-left-style: solid;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QTabWidget::pane {
    border: 1px solid #DDDDDD;
    border-radius: 4px;
    background-color: white;
}

QTabBar::tab {
    background-color: #F0F0F0;
    color: #333333;
    padding: 8px 15px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border: 1px solid #DDDDDD;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: white;
    border-bottom-color: white;
}

QTabBar::tab:hover:!selected {
    background-color: #E5E5E5;
}